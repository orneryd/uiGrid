{
  "name": "@ornery/ui-grid-vanilla",
  "version": "0.1.8-hotfix-1",
  "description": "Vanilla DOM wrapper for the Rust/WASM-backed @ornery/ui-grid-core custom element",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ornery/ui-grid-core": "0.1.8-hotfix-1"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "tsup": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "jsdom": "^26.0.0"
  },
  "scripts": {
    "start": "vite serve",
    "build": "npm run build --prefix ../ui-grid-core && tsup src/index.ts --format esm,cjs --dts --tsconfig tsconfig.json",
    "test": "vitest run"
  }
}
