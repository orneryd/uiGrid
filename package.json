{
  "name": "ui-grid",
  "version": "0.1.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:rust:wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build crates/ui-grid-wasm --target bundler --out-dir ../../dist/ui-grid-wasm --release",
    "build:rust:web": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build crates/ui-grid-wasm --target web --out-dir ../../dist/ui-grid-wasm-web --release",
    "build:pages": "ng build --configuration production --base-href /uiGrid/ --deploy-url /uiGrid/",
    "build:library": "ng build uiGridPackage",
    "build:library:preset": "node scripts/build-library-preset.mjs",
    "build:element": "ng run uiGrid:build-element",
    "build:package": "npm run build:library:preset -- --preset=full && npm run build:element && node scripts/prepare-release-package.mjs --presets full",
    "publish:package": "npm publish ./dist/npm-package --access public",
    "watch": "ng build --watch --configuration development",
    "start:react": "npm run start --prefix projects/ui-grid-react",
    "start:vanilla": "npm run build:library && npm run build:rust:web && npm run start --prefix projects/ui-grid-vanilla",
    "build:vanilla": "npm run build:library && npm run build:rust:web && npm run build --prefix projects/ui-grid-vanilla",
    "test": "ng test --watch=false && npm test --prefix projects/ui-grid-react && npm test --prefix projects/ui-grid-vanilla",
    "test:angular": "ng test --watch=false",
    "test:rust": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --workspace",
    "test:react": "npm test --prefix projects/ui-grid-react",
    "test:vanilla": "npm test --prefix projects/ui-grid-vanilla"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.10",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.10",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.3",
    "prettier": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
